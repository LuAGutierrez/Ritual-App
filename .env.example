# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Web Push — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@rituales.app

# Cron de Vercel (reminder diario)
CRON_SECRET=

# Mercado Pago — configurar en Supabase Secrets (no en Vercel)
# MP_ACCESS_TOKEN, MP_CURRENCY_ID, MP_BACK_URL (mismas secrets que ya
# usaba la suscripción vieja -- create-credit-checkout/mp-webhook las
# reusan, no hace falta nada nuevo). MP_AMOUNT ya no se usa (Sprint 5:
# el precio sale de credit_packages, no de una env var fija).
# MP_WEBHOOK_SECRET opcional, para verificar la firma del webhook.

# Groq (IA — Sprint 4). Gratis en console.groq.com, sin tarjeta.
GROQ_API_KEY=

# Sistema de créditos (Sprint 5) -- lib/ai/provider.ts
# AI_PROVIDER=groq (default) o "together" para saltar a Together AI
AI_PROVIDER=
TOGETHER_API_KEY=
